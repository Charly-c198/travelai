# ============================================================
# TravelAI 后端环境变量模板 —— 复制为 `.env` 后按需填写
#   复制： cp backend/app/.env.example backend/app/.env   (Windows: copy)
# ⚠️ 本文件不包含任何真实密钥，可安全提交到 git。
# ⚠️ 后端 `Settings` 配置了 `extra="forbid"`：
#     只认下面这些键；在 .env 里加未声明的键会导致启动报错。
# ============================================================

# ---- LLM 提供商: openai / deepseek / qwen ----
LLM_PROVIDER=qwen

# ---- 通义千问 Qwen（推荐）----
# ⚠️ 在 https://dashscope.console.aliyun.com/ 获取
QWEN_API_KEY=<your-dashscope-api-key>
QWEN_MODEL=qwen-plus
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# ---- 备用: DeepSeek / OpenAI（选配，不用可删）----
# DEEPSEEK_API_KEY=your-deepseek-key
# DEEPSEEK_MODEL=deepseek-chat
# DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
# OPENAI_API_KEY=your-openai-key
# OPENAI_MODEL=gpt-4o
# OPENAI_BASE_URL=https://api.openai.com/v1

# 推理模型调大输出令牌上限，避免正文为空
OPENAI_MAX_TOKENS=4096

# ---- RAG 向量检索（复用 Qwen 的 DashScope key，用阿里 embedding）----
EMBEDDING_MODEL=text-embedding-v3
VECTOR_STORE_TYPE=chroma
VECTOR_STORE_PATH=./data/vectorstore

# ---- 数据库（默认 SQLite；生产可换 PostgreSQL）----
DATABASE_URL=sqlite+aiosqlite:///./travelai.db
# postgresql+asyncpg://user:pass@localhost:5432/travelai

# ---- JWT（务必改成你自己的随机串）----
SECRET_KEY=change-me-to-a-long-random-secret

# ---- 高德 Web 服务（天气 / 地理编码）----
# ⚠️ 在 https://console.amap.com/ 申请，选「Web服务」key
AMAP_API_KEY=<your-amap-web-key>

# ---- RollingGo(道旅) MCP: 真实酒店 / 预订 ----
ROLLINGGO_API_KEY=<your-rollinggo-api-key>

# ---- Unsplash 目的地配图（选配，不配则回退本地图）----
# ⚠️ 在 https://unsplash.com/developers 创建应用
UNSPLASH_API_KEY=<your-unsplash-access-key>

# ---- 机票 CPS 落地页深链（选配：接联盟返佣时换成带渠道参数的链接）----
# FLIGHT_DEFAULT_ORIGIN=北京
# FLIGHT_BOOKING_URL_TEMPLATE=https://m.ctrip.com/webapp/flight/search/oneway?dcity={from}&acity={to}&ddate={date}
# ---- Wikipedia 实体配图：zh.wikipedia 在大陆被墙，默认关闭；海外/代理可开 ----
# WIKIPEDIA_ENABLED=false